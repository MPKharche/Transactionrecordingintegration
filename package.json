{
  "name": "ca-suite",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:app": "turbo dev --filter=@ca-suite/api --filter=@ca-suite/web",
    "google:oauth-console": "powershell -NoProfile -Command \"Start-Process 'https://console.cloud.google.com/apis/credentials'\"",
    "test": "vitest run",
    "test:audit": "node scripts/audit-lucide-imports.mjs",
    "test:api": "vitest run tests/api.test.ts",
    "test:migrate": "vitest run tests/migrations.test.ts",
    "test:web": "vitest run tests/web-smoke.test.tsx",
    "test:functional": "vitest run tests/functional.test.ts tests/shared.test.ts tests/duplicate-policy.test.ts",
    "test:extractor": "cd services/extractor && python -m pytest tests -q",
    "test:pipeline-split": "vitest run tests/pipeline-split.test.ts",
    "test:e2e": "playwright test",
    "test:workflows": "vitest run tests/workflows.test.ts",
    "test:regression": "node scripts/run-regression.mjs",
    "test:regression:ci": "node scripts/run-regression.mjs --skip-preflight",
    "test:all": "pnpm test:regression",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @ca-suite/db generate",
    "db:migrate": "pnpm --filter @ca-suite/db migrate",
    "db:push": "pnpm --filter @ca-suite/db push",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:clear": "tsx scripts/db-clear-demo.ts",
    "db:wipe": "tsx scripts/db-wipe-all.ts",
    "db:reset": "pnpm db:clear",
    "minio:clear": "tsx scripts/clear-minio.ts",
    "queue:flush": "node scripts/flush-pipeline-queue.mjs",
    "setup:env": "bash scripts/setup-env.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:prod": "bash scripts/deploy.sh",
    "ship": "node scripts/ship.mjs",
    "ship:quick": "node scripts/ship.mjs --quick",
    "ship:full": "node scripts/ship.mjs --full",
    "db:push:docker": "bash scripts/db-push.sh",
    "prod:bootstrap": "node scripts/prod-bootstrap.mjs",
    "prod:fresh": "node scripts/prod-fresh.mjs",
    "dev:prod-sim": "powershell -NoProfile -File scripts/launch-prod-sim.ps1",
    "prod:health": "powershell -NoProfile -File scripts/production-health.ps1",
    "verify:deploy": "node scripts/verify-deploy-setup.mjs",
    "prod:open": "powershell -NoProfile -File scripts/open-app.ps1",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "bullmq": "^5.34.8",
    "dotenv": "^16.4.7",
    "@ca-suite/shared": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "happy-dom": "^15.11.7",
    "postgres": "^3.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
