# Production template — copy to server as .env (never commit real .env)
# Profile: constrained VPS — ≤1.5 GB RAM peak, 2 cores (~30% CPU headroom left)
# See docs/SCALE.md

POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgresql://ca_user:change-me-strong@postgres:5432/ca_saas

REDIS_HOST=redis
REDIS_PORT=6379

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=ca-uploads

API_PORT=4000
NODE_ENV=production
AUTH_DEV_BYPASS=false
AUTH_SECRET=change-me-at-least-32-characters-long
API_PUBLIC_URL=https://your-domain.com
WEB_ORIGIN=https://your-domain.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOW_AUTO_JOIN=false

EXTRACTOR_URL=http://extractor:8000
EXTRACTOR_SHARED_SECRET=change-me-random
OPENROUTER_API_KEY=
# Primary model (fast, cheap, JSON-native)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Fallback: used automatically when primary returns 4xx/5xx
OPENROUTER_MODEL_FALLBACK=google/gemini-2.5-flash-lite
EXTRACT_USE_OPENROUTER_ONLY=true

VITE_API_URL=/api
VITE_ALLOW_DEV_LOGIN=false
VITE_UPLOAD_CONCURRENCY=2

# ─── Constrained throughput (2 cores @ 70% used, ≤1.5 GB stack RAM) ─────────
DEPLOY_PROFILE=constrained
WORKER_CONCURRENCY=2
OCR_CONCURRENCY=1
EXTRACT_LLM_CONCURRENCY=1
EXTRACTOR_WORKERS=1
EXTRACT_MAX_CONCURRENT=1
DATABASE_POOL_MAX=6
UPLOAD_CLIENT_CONCURRENCY=2
# PDF text in worker; image OCR in Python extractor (saves ~200 MB in worker)
WORKER_DEFER_IMAGE_OCR=true

# Pipeline resilience (queue backpressure + timeouts)
PIPELINE_MAX_QUEUE_DEPTH=40
PIPELINE_JOB_ATTEMPTS=3
MAX_UPLOAD_BYTES=20971520
EXTRACTOR_TIMEOUT_MS=120000
