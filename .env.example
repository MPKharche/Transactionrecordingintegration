# Database
DATABASE_URL=postgresql://ca_user:ca_pass@localhost:5433/ca_saas

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ca-uploads

# API
API_PORT=4000
# Production: AUTH_DEV_BYPASS=false
AUTH_DEV_BYPASS=false

# Extractor (LLM runs in Python sidecar — key is read there, not in Vite)
EXTRACTOR_URL=http://localhost:8000
EXTRACTOR_SHARED_SECRET=change-me
# https://openrouter.ai/keys — used by services/extractor (and Docker extractor/worker)
OPENROUTER_API_KEY=
# Latest DeepSeek on OpenRouter with JSON-friendly chat API (see openrouter.ai/deepseek/deepseek-v3.2)
OPENROUTER_MODEL=deepseek/deepseek-v3.2

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOW_AUTO_JOIN=false
AUTH_SECRET=change-me-at-least-32-characters-long
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

# Web (Vite) — app always uses API; no embedded demo data
VITE_API_URL=/api
VITE_API_PUBLIC_URL=http://localhost:4000
# Local dev only: show Dev login button (requires AUTH_DEV_BYPASS=true on API)
VITE_ALLOW_DEV_LOGIN=true

# ─── Throughput (production — see docs/SCALE.md) ─────────────────────────────
# ~100 users, 10–20 parallel uploads on a single lightweight VPS
WORKER_CONCURRENCY=12
OCR_CONCURRENCY=6
EXTRACT_LLM_CONCURRENCY=4
EXTRACTOR_WORKERS=2
EXTRACT_MAX_CONCURRENT=4
DATABASE_POOL_MAX=20
UPLOAD_CLIENT_CONCURRENCY=5
VITE_UPLOAD_CONCURRENCY=5
