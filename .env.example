# Database
DATABASE_URL=postgresql://ca_user:ca_pass@localhost:5433/ca_saas

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ca-uploads

# API
API_PORT=4000
# Production: AUTH_DEV_BYPASS=false
AUTH_DEV_BYPASS=false

# Extractor (LLM runs in Python sidecar — key is read there, not in Vite)
EXTRACTOR_URL=http://localhost:8011
EXTRACTOR_SHARED_SECRET=change-me
# https://openrouter.ai/keys — used by services/extractor (and Docker extractor/worker)
OPENROUTER_API_KEY=
# Primary model: DeepSeek V4 Flash (fast, cheap, JSON-native)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Fallback model: used automatically when primary returns 4xx/5xx
OPENROUTER_MODEL_FALLBACK=google/gemini-2.5-flash-lite
# When true (default if OPENROUTER_API_KEY set): split + extract use OpenRouter only — no heuristic fallback
EXTRACT_USE_OPENROUTER_ONLY=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOW_AUTO_JOIN=false
AUTH_SECRET=change-me-at-least-32-characters-long
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
# Remote production URL for `pnpm prod:health --remote` (not used at runtime)
PRODUCTION_URL=

# Web (Vite) — app always uses API; no embedded demo data
VITE_API_URL=/api
VITE_API_PUBLIC_URL=http://localhost:4000
# Never auto-seed Acme/Beta demo clients (explicit opt-in only)
SEED_DEMO=false
# Local dev only: show Dev login button (requires AUTH_DEV_BYPASS=true on API)
VITE_ALLOW_DEV_LOGIN=true

# ─── Throughput (see docs/SCALE.md) ───────────────────────────────────────────
# Standard VPS (~4 GB RAM): use values in docs/SCALE.md "Standard profile"
# Constrained VPS (≤1.5 GB RAM, 2 cores busy): copy .env.production.example

# Local dev (moderate — worker not in Docker)
# WORKER_CONCURRENCY=4
# OCR_CONCURRENCY=2
# EXTRACT_LLM_CONCURRENCY=2

# Production constrained (default on server — matches docker-compose defaults)
DEPLOY_PROFILE=constrained
WORKER_CONCURRENCY=2
OCR_CONCURRENCY=1
EXTRACT_LLM_CONCURRENCY=1
EXTRACTOR_WORKERS=1
EXTRACT_MAX_CONCURRENT=1
DATABASE_POOL_MAX=6
UPLOAD_CLIENT_CONCURRENCY=2
VITE_UPLOAD_CONCURRENCY=2
WORKER_DEFER_IMAGE_OCR=true
